# Names only. Real values live in Vercel project env vars (Production / Preview), never in git.
# Build-time values are read by scripts/build.mjs and baked into the bundle with `ng build --define`.

# Sentry error tracking. Unset = Sentry is not loaded at all (no-op).
SENTRY_DSN=
# dev | prod. Defaults to prod when VERCEL_ENV=production, else dev.
SENTRY_ENVIRONMENT=

# PostHog analytics (NEX-1050, not wired yet)
POSTHOG_KEY=
POSTHOG_HOST=

# Products sync (scripts/sync-products.mjs --apply only; default is a dry run)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
